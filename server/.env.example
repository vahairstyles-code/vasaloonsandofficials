PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/va-haircut
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Initial admin account (created on first start; you must change the password at first login)
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe@123
# Cloudinary (optional: if unset, uploads are stored in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public URL of this API (needed only for local-disk uploads in production)
PUBLIC_API_URL=
